{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "capture-studio.project"
    },
    "formatVersion": {
      "type": "number",
      "const": 1,
      "description": "Major; minor changes are additive"
    },
    "id": {
      "type": "string",
      "pattern": "^prj_[0-9A-Za-z]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "ISO 8601 timestamp in UTC (Z suffix)"
    },
    "modifiedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "ISO 8601 timestamp in UTC (Z suffix)"
    },
    "createdBy": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string",
          "const": "capture-studio"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "app",
        "version"
      ]
    },
    "recording": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "recording",
                "finalizing",
                "complete",
                "recovered",
                "failed"
              ]
            },
            "failureReason": {
              "type": "string"
            },
            "sessionId": {
              "type": "string",
              "pattern": "^ses_[0-9A-Za-z]+$"
            },
            "startedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "Wall clock at t0; informational only"
            },
            "durationUs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Session-clock length, pauses included"
            },
            "clockMode": {
              "type": "string",
              "enum": [
                "shared-capture",
                "arrival-calibrated",
                "hybrid"
              ],
              "description": "hybrid: some media share the capture domain, others are arrival-calibrated (§9.2)"
            },
            "pauses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startUs": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991,
                    "description": "Integer microseconds"
                  },
                  "endUs": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991,
                    "description": "Integer microseconds"
                  }
                },
                "required": [
                  "startUs",
                  "endUs"
                ]
              },
              "description": "Session-clock intervals"
            },
            "source": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "monitor",
                    "window"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "widthPx": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "heightPx": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "region": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "width": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "height": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "width",
                        "height"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "widthPx",
                "heightPx",
                "region"
              ]
            },
            "platform": {
              "type": "object",
              "properties": {
                "os": {
                  "type": "string",
                  "enum": [
                    "linux",
                    "win32",
                    "darwin"
                  ]
                },
                "session": {
                  "type": "string",
                  "enum": [
                    "wayland",
                    "x11"
                  ]
                },
                "desktop": {
                  "type": "string"
                },
                "electron": {
                  "type": "string"
                },
                "chromium": {
                  "type": "string"
                },
                "ffmpeg": {
                  "type": "string"
                }
              },
              "required": [
                "os",
                "electron",
                "chromium",
                "ffmpeg"
              ]
            }
          },
          "required": [
            "state",
            "sessionId",
            "startedAt",
            "durationUs",
            "clockMode",
            "pauses",
            "source",
            "platform"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "null for projects not created by recording"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^med_[0-9A-Za-z]+$"
          },
          "role": {
            "type": "string",
            "enum": [
              "screen",
              "camera",
              "microphone",
              "system-audio",
              "imported"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "video",
              "audio"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$)[^\\u0000]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "missing",
              "recovered",
              "failed"
            ]
          },
          "durationUs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "File-local duration"
          },
          "startOffsetUs": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Reference-clock time of the file's first sample"
          },
          "syncAdjustUs": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "User sync nudge (default 0)"
          },
          "clockRatio": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Reference µs per file µs (default 1)"
          },
          "endedEarly": {
            "type": "boolean"
          },
          "video": {
            "type": "object",
            "properties": {
              "codec": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "frameRateNominal": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "variableFrameRate": {
                "type": "boolean"
              }
            },
            "required": [
              "codec",
              "width",
              "height",
              "frameRateNominal",
              "variableFrameRate"
            ]
          },
          "audio": {
            "type": "object",
            "properties": {
              "codec": {
                "type": "string"
              },
              "sampleRate": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "channels": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "syncCheckpointsPath": {
                "type": "string",
                "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))(?!.*\\/\\/)(?!.*\\/$)[^\\u0000]+$"
              },
              "discontinuities": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "codec",
              "sampleRate",
              "channels",
              "discontinuities"
            ]
          },
          "encoder": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "hardware": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "hardware"
            ]
          },
          "sync": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "shared",
                  "arrival-calibrated"
                ]
              },
              "offsetUs": {
                "description": "Calibrator offset: sessionUs = timestampUs + offsetUs",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "clockHandshakeUs": {
                "description": "Cross-process clock handshake applied (system audio)",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "outputLatencyUs": {
                "description": "Sink output latency added to system audio (the monitor runs ahead of the speakers)",
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "mode"
            ]
          },
          "stats": {
            "type": "object",
            "properties": {
              "framesEncoded": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "framesDropped": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "device": {
            "description": "Informational; never used to re-open a device",
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              }
            },
            "required": [
              "label"
            ]
          }
        },
        "required": [
          "id",
          "role",
          "kind",
          "path",
          "status",
          "durationUs",
          "startOffsetUs",
          "syncAdjustUs",
          "clockRatio"
        ]
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^cmp_[0-9A-Za-z]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "screen",
              "face-voice",
              "system-audio"
            ]
          },
          "mediaIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^med_[0-9A-Za-z]+$"
            },
            "description": "face-voice: [camera?, microphone?]"
          }
        },
        "required": [
          "id",
          "type",
          "mediaIds"
        ]
      }
    },
    "timeline": {
      "type": "object",
      "properties": {
        "canvas": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 64,
              "maximum": 7680,
              "multipleOf": 2
            },
            "height": {
              "type": "integer",
              "minimum": 64,
              "maximum": 7680,
              "multipleOf": 2
            },
            "background": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "color"
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
                }
              },
              "required": [
                "type",
                "color"
              ]
            }
          },
          "required": [
            "width",
            "height",
            "background"
          ]
        },
        "frameRate": {
          "type": "number",
          "enum": [
            24,
            25,
            30,
            50,
            60
          ]
        },
        "marks": {
          "type": "object",
          "properties": {
            "inUs": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Integer microseconds"
                },
                {
                  "type": "null"
                }
              ]
            },
            "outUs": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "Integer microseconds"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "inUs",
            "outUs"
          ]
        },
        "tracks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^trk_[0-9A-Za-z]+$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "componentId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^cmp_[0-9A-Za-z]+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "locked": {
                    "type": "boolean"
                  },
                  "clips": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^clp_[0-9A-Za-z]+$"
                        },
                        "mediaId": {
                          "type": "string",
                          "pattern": "^med_[0-9A-Za-z]+$"
                        },
                        "timelineStartUs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "description": "Integer microseconds, ≥ 0"
                        },
                        "sourceStartUs": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991,
                          "description": "In the media's reference clock (session clock for recordings)"
                        },
                        "sourceEndUs": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991,
                          "description": "In the media's reference clock (session clock for recordings)"
                        },
                        "linkId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^lnk_[0-9A-Za-z]+$"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Clips sharing a linkId edit together"
                        }
                      },
                      "required": [
                        "id",
                        "mediaId",
                        "timelineStartUs",
                        "sourceStartUs",
                        "sourceEndUs",
                        "linkId"
                      ]
                    }
                  },
                  "type": {
                    "type": "string",
                    "const": "video"
                  },
                  "hidden": {
                    "type": "boolean"
                  },
                  "layout": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "screen"
                          },
                          "crop": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "x": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "y": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "width": {
                                    "type": "integer",
                                    "exclusiveMinimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "height": {
                                    "type": "integer",
                                    "exclusiveMinimum": 0,
                                    "maximum": 9007199254740991
                                  }
                                },
                                "required": [
                                  "x",
                                  "y",
                                  "width",
                                  "height"
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "fit": {
                            "type": "string",
                            "const": "contain"
                          }
                        },
                        "required": [
                          "kind",
                          "crop",
                          "fit"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "overlay"
                          },
                          "centerX": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1,
                            "description": "Fraction of the canvas width"
                          },
                          "centerY": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1,
                            "description": "Fraction of the canvas height"
                          },
                          "width": {
                            "type": "number",
                            "minimum": 0.05,
                            "maximum": 0.5,
                            "description": "Fraction of the canvas width"
                          },
                          "shape": {
                            "type": "string",
                            "enum": [
                              "rectangle",
                              "rounded",
                              "circle"
                            ]
                          },
                          "cornerRadius": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 0.5,
                            "description": "Fraction of the short side (rounded only)"
                          },
                          "mirror": {
                            "type": "boolean"
                          },
                          "crop": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "x": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "y": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "width": {
                                    "type": "integer",
                                    "exclusiveMinimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "height": {
                                    "type": "integer",
                                    "exclusiveMinimum": 0,
                                    "maximum": 9007199254740991
                                  }
                                },
                                "required": [
                                  "x",
                                  "y",
                                  "width",
                                  "height"
                                ]
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "description": "null = full frame (rectangle/rounded) or centred square (circle)"
                          }
                        },
                        "required": [
                          "kind",
                          "centerX",
                          "centerY",
                          "width",
                          "shape",
                          "cornerRadius",
                          "mirror",
                          "crop"
                        ]
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "name",
                  "componentId",
                  "locked",
                  "clips",
                  "type",
                  "hidden",
                  "layout"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^trk_[0-9A-Za-z]+$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "componentId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^cmp_[0-9A-Za-z]+$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "locked": {
                    "type": "boolean"
                  },
                  "clips": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^clp_[0-9A-Za-z]+$"
                        },
                        "mediaId": {
                          "type": "string",
                          "pattern": "^med_[0-9A-Za-z]+$"
                        },
                        "timelineStartUs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "description": "Integer microseconds, ≥ 0"
                        },
                        "sourceStartUs": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991,
                          "description": "In the media's reference clock (session clock for recordings)"
                        },
                        "sourceEndUs": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991,
                          "description": "In the media's reference clock (session clock for recordings)"
                        },
                        "linkId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^lnk_[0-9A-Za-z]+$"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Clips sharing a linkId edit together"
                        }
                      },
                      "required": [
                        "id",
                        "mediaId",
                        "timelineStartUs",
                        "sourceStartUs",
                        "sourceEndUs",
                        "linkId"
                      ]
                    }
                  },
                  "type": {
                    "type": "string",
                    "const": "audio"
                  },
                  "gainDb": {
                    "type": "number",
                    "minimum": -60,
                    "maximum": 12
                  },
                  "muted": {
                    "type": "boolean"
                  },
                  "solo": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "componentId",
                  "locked",
                  "clips",
                  "type",
                  "gainDb",
                  "muted",
                  "solo"
                ]
              }
            ]
          },
          "description": "Bottom-to-top render order for video"
        }
      },
      "required": [
        "canvas",
        "frameRate",
        "marks",
        "tracks"
      ]
    },
    "exportPrefs": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "draft",
            "standard",
            "high"
          ]
        },
        "width": {
          "type": "integer",
