{
  "name": "capture-studio",
  "productName": "Capture Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Screen recorder and teaching-focused video editor.",
  "license": "GPL-3.0-or-later",
  "author": "Capture Studio contributors",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json && tsc -p src/shared/tsconfig.json && tsc -p tests/e2e/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "fetch:ffmpeg": "tsx scripts/fetch-ffmpeg.ts",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "package:linux": "npm run fetch:ffmpeg -- --platform linux-x64 && electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "immer": "11.1.18",
    "mediabunny": "1.62.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
